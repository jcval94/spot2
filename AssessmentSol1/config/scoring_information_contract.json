{
  "contract_version": "0.1.2",
  "phase": "PROMPT_0",
  "stage_score_times": {
    "T0": "leads.created_at",
    "T1": "first inquiries.inquiry_at for lead_id",
    "T2": "current second-or-later inquiries.inquiry_at, while pre-known-visit"
  },
  "source_policy": {
    "leads": {
      "default": "KNOWN_AT_T0_IF_CAPTURED_AT_CREATED_AT",
      "blocked": [
        "lead_score_internal"
      ],
      "audit_or_conditional": [
        "prior_searches",
        "prior_inquiries",
        "has_converted_before"
      ]
    },
    "inquiries": {
      "current_request_fields": "KNOWN_AT_INQUIRY_AT",
      "current_broker_response": "FUTURE_BLOCKED",
      "prior_response": "KNOWN_ONLY_IF_RESPONSE_EVENT_TIME_LE_SCORE_TIME"
    },
    "spots": {
      "descriptive_fields": "CONDITIONAL_ON_SPOT_CREATED_AND_FIELD_IMMUTABILITY",
      "blocked_current_state": [
        "days_on_market",
        "total_inquiries",
        "total_views",
        "is_active"
      ],
      "structural_candidate_guardrails": {
        "fields": [
          "sector_name",
          "type_name",
          "state",
          "municipality",
          "settlement",
          "corridor",
          "region",
          "lat",
          "lon",
          "area_sqm",
          "modality"
        ],
        "policy": "ASSUMED_STRUCTURAL_FROM_SPOT_CREATION",
        "condition": "spots.created_at <= score_time",
        "model_role": "POLICY_GUARDRAIL_NOT_LEADQUALITY_FEATURE"
      },
      "potentially_mutable_unversioned": [
        "broker_id",
        "title",
        "description",
        "price_sqm_mxn_rent",
        "price_sqm_mxn_sale",
        "price_total_mxn_rent",
        "price_total_mxn_sale",
        "maintenance_cost_mxn"
      ]
    },
    "spot_attributes": {
      "policy": "KNOWN_AT_T1_T2_UNDER_EXPLICIT_IMMUTABILITY_ASSUMPTION",
      "condition": "selected spot exists at score_time: spots.created_at <= score_time",
      "raw_attribute_timestamp": "ABSENT",
      "effective_time_contract": "assume values are invariant from spot creation",
      "T0": "NO_SELECTED_SPOT",
      "T1": "AUTHORIZED",
      "T2": "AUTHORIZED"
    },
    "availability_snapshot": {
      "policy": "BACKWARD_ASOF_ONLY",
      "join": "max(snapshot_date) where snapshot_date <= score_time for spot_id",
      "stale_gt_90d": "UNKNOWN_FOR_SERVICEABILITY",
      "competing_inquiries_30d": "CONDITIONAL_PENDING_WINDOW_SEMANTICS"
    },
    "market_context": {
      "policy": "BLOCKED_UNTIL_PUBLICATION_OR_EFFECTIVE_TIME_IS_PROVEN"
    }
  },
  "final_holdout_language": "procedural final holdout when historically inspected; never pristine unseen holdout"
}
